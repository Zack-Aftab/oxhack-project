# Copy to .env.local (ignored). Values here are safe placeholders only.

# Data source for the UI's single API client.
#   sample = committed fixtures under fixtures/queuecare, in-memory scenario per browser tab
#   live   = same-origin /api/... Route Handlers (backend owner's work; failures are shown, never replaced with samples)
NEXT_PUBLIC_DATA_MODE=sample

# Backend/server-only variables are added by the backend owner when the routes land.
# Never prefix a secret with NEXT_PUBLIC_. Examples of names expected later (values from each teammate's own Supabase project):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# GET /api/catalog: server-only Supabase REST access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY= (use one key binding, not both).
SUPABASE_DATASET_ID=month-v5
