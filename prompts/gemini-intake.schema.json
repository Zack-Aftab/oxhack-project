{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QueueCare Gemini demo intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categories",
    "pain_score",
    "urgency_rating",
    "is_emergency",
    "needs_more_information",
    "follow_up_question",
    "reason"
  ],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "fracture_sprain_or_dislocation",
          "cuts_or_wounds",
          "head_injury_or_neurological_symptoms",
          "breathing_problems",
          "chest_pain_or_heart_symptoms",
          "abdominal_or_stomach_problems",
          "other_or_uncategorised",
          "unknown"
        ]
      }
    },
    "pain_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 10
    },
    "urgency_rating": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 10
    },
    "is_emergency": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "needs_more_information": {
      "type": "boolean"
    },
    "follow_up_question": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 240
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  }
}
